<!-- The inspector's manifest components live ONLY here, in the debug-linked
     impl AAR. They must NOT be declared in the thin plugin module, or they would
     merge into every release regardless of which engine is linked — defeating
     the whole exercise (RELEASE_STRIPPING.md §3.3). The no-op declares none of
     them, so a release build's merged manifest has no inspector entries.

     Namespace (dev.alifhasnain.falconer) comes from build.gradle, so the relative
     `.ui.*` / `.notification.*` names below resolve to the real classes. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name=".ui.FalconerActivity"
            android:taskAffinity="dev.alifhasnain.falconer"
            android:launchMode="singleTask"
            android:exported="false"
            android:label="Falconer"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <receiver
            android:name=".notification.FalconerClearReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.falconer.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/falconer_file_paths" />
        </provider>
    </application>
</manifest>
